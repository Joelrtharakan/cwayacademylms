t/static/chunks/0yb2wil16uz6h.js\"/><script src=\"/_next/static/chunks/09djkez_-y8yp.js\" async=\"\"></script><script src=\"/_next/static/chunks/10u3y4bw1ayzs.js\" async=\"\"></script><script src=\"/_next/static/chunks/06xl4psnkxkoa.js\" async=\"\"></script><script src=\"/_next/static/chunks/0pqt~8bl3ukh4.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-0hnm7rj19ofh7.js\" async=\"\"></script><script src=\"/_next/static/chunks/0uhyadmmf30b-.js\" async=\"\"></script><script src=\"/_next/static/chunks/114vggoq28h-..js\" async=\"\"></script><script src=\"/_next/static/chunks/03wjaq-j8ui2z.js\" async=\"\"></script><script src=\"/_next/static/chunks/0sqoe4czrp.af.js\" async=\"\"></script><script src=\"/_next/static/chunks/10su.i6qbbwvv.js\" async=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><title>CWAY Academy — Coach, Challenge, and Commission!</title><meta name=\"description\" content=\"CWAY Academy equips rural pastors, lay leaders, and Christian disciples through Bible-based theological education and leadership training in local Indian languages. A ministry of CWAY MISSIONS Religious Trust, Bangalore, India.\"/><link rel=\"author\" href=\"https://cwayacademy.org\"/><meta name=\"author\" content=\"CWAY Academy\"/><link rel=\"manifest\" href=\"/manifest.webmanifest\"/><meta name=\"keywords\" content=\"Christian leadership training India,Online theological education certificate,Bible training for rural pastors,Indigenous church leadership training,Five-fold ministry courses,Accredited theological training India,CWAY Academy,CWAY Missions,Ministry training India,Theological seminary online\"/><meta name=\"creator\" content=\"CWAY MISSIONS Religious Trust\"/><meta name=\"publisher\" content=\"CWAY Academy\"/><meta name=\"robots\" content=\"index, follow\"/><meta name=\"googlebot\" content=\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"/><meta name=\"google-site-verification\" content=\"your-google-verification-code\"/><meta property=\"og:title\" content=\"CWAY Academy — Coach, Challenge, and Commission!\"/><meta property=\"og:description\" content=\"Equipping rural pastors, lay leaders, and Christian disciples through Bible-based theological education and leadership training.\"/><meta property=\"og:url\" content=\"https://cwayacademy.org\"/><meta property=\"og:site_name\" content=\"CWAY Academy\"/><meta property=\"og:locale\" content=\"en_IN\"/><meta property=\"og:image\" content=\"https://cwayacademy.org/og-image.jpg\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"CWAY Academy — Theological Education Platform\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"CWAY Academy — Coach, Challenge, and Commission!\"/><meta name=\"twitter:description\" content=\"Equipping rural pastors and Christian leaders through premium theological education.\"/><meta name=\"twitter:image\" content=\"https://cwayacademy.org/og-image.jpg\"/><link rel=\"shortcut icon\" href=\"/favicon-16x16.png\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.0xpm.hl6sk9qz.ico\" sizes=\"48x48\" type=\"image/x-icon\"/><link rel=\"icon\" href=\"/favicon.ico\"/><link rel=\"apple-touch-icon\" href=\"/apple-touch-icon.png\"/><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"EducationalOrganization\",\"name\":\"CWAY Academy\",\"description\":\"A premier theological training institution equipping rural pastors, lay leaders, and Christian disciples through Bible-based education.\",\"url\":\"https://cwayacademy.org\",\"logo\":\"https://cwayacademy.org/logo.png\",\"contactPoint\":{\"@type\":\"ContactPoint\",\"contactType\":\"admissions\",\"email\":\"admissions@cwayacademy.org\"},\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Bangalore\",\"addressRegion\":\"Karnataka\",\"addressCountry\":\"IN\"},\"foundingOrganization\":{\"@type\":\"Organization\",\"name\":\"CWAY MISSIONS Religious Trust\"}}</script><script src=\"/_next/static/chunks/03~yq9q893hmn.js\" noModule=\"\"></script></head><body><div hidden=\"\"><!--$--><!--/$--></div><section aria-label=\"Notifications alt+T\" tabindex=\"-1\" aria-live=\"polite\" aria-relevant=\"additions text\" aria-atomic=\"false\"></section><div><section class=\"parchment-bg\" style=\"padding:5rem 0 3rem\"><div class=\"container\"><div class=\"section-label\">Partner with the Ministry</div><h1 style=\"margin-bottom:1rem\">Give to <span class=\"gradient-text-gold\">Advance the Kingdom</span></h1><div class=\"gold-divider gold-divider-left\"></div><p style=\"max-width:560px;font-size:1.05rem;line-height:1.9;color:var(--text-secondary)\">Your generous giving directly funds theological training for rural pastors, women&#x27;s ministry leaders, and Christian disciples across India who cannot afford education but are deeply called to serve.</p></div></section><section class=\"section-padding\"><div class=\"container\" style=\"max-width:900px\"><div class=\"donate-layout-grid\" style=\"display:grid;grid-template-columns:1.5fr 1fr;gap:3rem;align-items:start\"><div class=\"card-cream\" style=\"padding:2.5rem\"><h3 style=\"margin-bottom:1.5rem\">Make a Donation</h3><div style=\"margin-bottom:1.5rem\"><label class=\"form-label\">Select Amount (INR) *</label><div style=\"display:grid;grid-template-columns:repeat(3, 1fr);gap:0.75rem;margin-bottom:0.75rem\"><button style=\"padding:0.75rem;border-radius:10px;border:1.5px solid var(--border-light);background:var(--cream-base);color:var(--text-secondary);font-weight:700;font-size:0.95rem;cursor:pointer;transition:all 0.2s;font-family:var(--font-serif)\">₹<!-- -->500</button><button style=\"padding:0.75rem;border-radius:10px;border:1.5px solid var(--border-light);background:var(--cream-base);color:var(--text-secondary);font-weight:700;font-size:0.95rem;cursor:pointer;transition:all 0.2s;font-family:var(--font-serif)\">₹<!-- -->1,000</button><button style=\"padding:0.75rem;border-radius:10px;border:1.5px solid var(--border-light);background:var(--cream-base);color:var(--text-secondary);font-weight:700;font-size:0.95rem;cursor:pointer;transition:all 0.2s;font-family:var(--font-serif)\">₹<!-- -->2,000</button><button style=\"padding:0.75rem;border-radius:10px;border:1.5px solid var(--border-light);background:var(--cream-base);color:var(--text-secondary);font-weight:700;font-size:0.95rem;cursor:pointer;transition:all 0.2s;font-family:var(--font-serif)\">₹<!-- -->5,000</button><button style=\"padding:0.75rem;border-radius:10px;border:1.5px solid var(--border-light);background:var(--cream-base);color:var(--text-secondary);font-weight:700;font-size:0.95rem;cursor:pointer;transition:all 0.2s;font-family:var(--font-serif)\">₹<!-- -->10,000</button></div><div><label class=\"form-label\" for=\"custom-amount\">Or enter custom amount</label><div style=\"position:relative\"><span style=\"position:absolute;left:1rem;top:50%;transform:translateY(-50%);color:var(--text-muted);font-weight:600\">₹</span><input id=\"custom-amount\" type=\"number\" class=\"form-input\" style=\"padding-left:2rem\" placeholder=\"Enter amount\" min=\"100\" value=\"\"/></div></div></div><div style=\"margin-bottom:1.5rem\"><label class=\"form-label\" for=\"donation-purpose\">Donation Purpose</label><select id=\"donation-purpose\" class=\"form-input\"><option selected=\"\">General Ministry Fund</option><option>Scholarship Fund — Rural Pastors</option><option>Course Development</option><option>Technology &amp; Infrastructure</option><option>Women&#x27;s Ministry Training</option><option>Church Planting Support</option></select></div><div style=\"margin-bottom:1.5rem;display:flex;align-items:center;gap:0.75rem;padding:1rem;background:var(--cream-mid);border-radius:10px\"><input id=\"recurring\" type=\"checkbox\" style=\"width:18px;height:18px;accent-color:var(--gold-primary)\"/><label for=\"recurring\" style=\"font-size:0.9rem;font-weight:600;color:var(--navy-deep);cursor:pointer\">Make this a monthly recurring gift</label></div><div class=\"form-row-2col\" style=\"display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1.25rem\"><div><label class=\"form-label\" for=\"donor-name\">Full Name *</label><input id=\"donor-name\" class=\"form-input\" placeholder=\"Your Name\" value=\"\"/></div><div><label class=\"form-label\" for=\"donor-email\">Email *</label><input id=\"donor-email\" type=\"email\" class=\"form-input\" placeholder=\"you@email.com\" value=\"\"/></div></div><div style=\"display:flex;gap:1rem;padding:1rem;background:rgba(61,122,75,0.06);border-radius:10px;margin-bottom:1.5rem\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--success)\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield\" aria-hidden=\"true\" style=\"flex-shrink:0;margin-top:2px\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path></svg><p style=\"font-size:0.78rem;color:var(--text-secondary);line-height:1.6;margin:0\">Donations are processed securely via Razorpay (India) or Stripe (International). Tax receipts are issued under CWAY MISSIONS Religious Trust (India — 80G exemption applicable).</p></div><button class=\"btn-primary\" style=\"width:100%;justify-content:center;font-size:1rem;padding:1rem\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-heart\" aria-hidden=\"true\"><path d=\"M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5\"></path></svg>Give Now</button></div><div><h3 style=\"margin-bottom:1.5rem;font-size:1.1rem\">Your Gift Makes an Impact</h3><div style=\"display:flex;flex-direction:column;gap:1.25rem\"><div style=\"display:flex;gap:1rem;align-items:flex-start\"><div style=\"background:var(--gold-primary);color:white;font-weight:700;font-size:0.85rem;padding:0.375rem 0.75rem;border-radius:8px;flex-shrink:0;font-family:var(--font-serif)\">₹500</div><p style=\"font-size:0.875rem;line-height:1.6;color:var(--text-secondary);margin:0\">Funds one week of study materials for a rural pastor</p></div><div style=\"display:flex;gap:1rem;align-items:flex-start\"><div style=\"background:var(--gold-primary);color:white;font-weight:700;font-size:0.85rem;padding:0.375rem 0.75rem;border-radius:8px;flex-shrink:0;font-family:var(--font-serif)\">₹1,000</div><p style=\"font-size:0.875rem;line-height:1.6;color:var(--text-secondary);margin:0\">Sponsors a student&#x27;s access to an entire course module</p></div><div style=\"display:flex;gap:1rem;align-items:flex-start\"><div style=\"background:var(--gold-primary);color:white;font-weight:700;font-size:0.85rem;padding:0.375rem 0.75rem;border-radius:8px;flex-shrink:0;font-family:var(--font-serif)\">₹2,000</div><p style=\"font-size:0.875rem;line-height:1.6;color:var(--text-secondary);margin:0\">Covers one month&#x27;s scholarship for a rural ministry leader</p></div><div style=\"display:flex;gap:1rem;align-items:flex-start\"><div style=\"background:var(--gold-primary);color:white;font-weight:700;font-size:0.85rem;padding:0.375rem 0.75rem;border-radius:8px;flex-shrink:0;font-family:var(--font-serif)\">₹5,000</div><p style=\"font-size:0.875rem;line-height:1.6;color:var(--text-secondary);margin:0\">Fully sponsors one student for a 12-week certificate course</p></div><div style=\"display:flex;gap:1rem;align-items:flex-start\"><div style=\"background:var(--gold-primary);color:white;font-weight:700;font-size:0.85rem;padding:0.375rem 0.75rem;border-radius:8px;flex-shrink:0;font-family:var(--font-serif)\">₹10,000</div><p style=\"font-size:0.875rem;line-height:1.6;color:var(--text-secondary);margin:0\">Funds course development in a new Indian language</p></div></div><div class=\"scripture-block\" style=\"margin-top:2rem\">&quot;Each one must give as he has decided in his heart, not reluctantly or under compulsion, for God loves a cheerful giver.&quot;<span class=\"scripture-reference\">— 2 Corinthians 9:7</span></div></div></div></div></section></div><!--$--><!--/$--><script src=\"/_next/static/chunks/0yb2wil16uz6h.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[73857,[\\\"/_next/static/chunks/0uhyadmmf30b-.js\\\",\\\"/_next/static/chunks/114vggoq28h-..js\\\",\\\"/_next/static/chunks/03wjaq-j8ui2z.js\\\"],\\\"QueryProvider\\\"]\\n3:I[36599,[\\\"/_next/static/chunks/0uhyadmmf30b-.js\\\",\\\"/_next/static/chunks/114vggoq28h-..js\\\",\\\"/_next/static/chunks/03wjaq-j8ui2z.js\\\"],\\\"ConfirmProvider\\\"]\\n4:I[46696,[\\\"/_next/static/chunks/0uhyadmmf30b-.js\\\",\\\"/_next/static/chunks/114vggoq28h-..js\\\",\\\"/_next/static/chunks/03wjaq-j8ui2z.js\\\"],\\\"Toaster\\\"]\\n5:I[78637,[\\\"/_next/static/chunks/0uhyadmmf30b-.js\\\",\\\"/_next/static/chunks/114vggoq28h-..js\\\",\\\"/_next/static/chunks/03wjaq-j8ui2z.js\\\"],\\\"GlobalReveal\\\"]\\n6:I[23536,[\\\"/_next/static/chunks/0uhyadmmf30b-.js\\\",\\\"/_next/static/chunks/114vggoq28h-..js\\\",\\\"/_next/static/chunks/03wjaq-j8ui2z.js\\\"],\\\"SmoothScroll\\\"]\\n7:I[39756,[\\\"/_next/static/chunks/0uhyadmmf30b-.js\\\",\\\"/_next/static/chunks/114vggoq28h-..js\\\",\\\"/_next/static/chunks/03wjaq-j8ui2z.js\\\"],\\\"default\\\"]\\n8:I[37457,[\\\"/_next/static/chunks/0uhyadmmf30b-.js\\\",\\\"/_next/static/chunks/114vggoq28h-..js\\\",\\\"/_next/static/chunks/03wjaq-j8ui2z.js\\\"],\\\"default\\\"]\\n9:I[25823,[\\\"/_next/static/chunks/0uhyadmmf30b-.js\\\",\\\"/_next/stati