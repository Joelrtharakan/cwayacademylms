name=\"googlebot\" content=\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"/><meta name=\"google-site-verification\" content=\"your-google-verification-code\"/><meta property=\"og:title\" content=\"CWAY Academy — Coach, Challenge, and Commission!\"/><meta property=\"og:description\" content=\"Equipping rural pastors, lay leaders, and Christian disciples through Bible-based theological education and leadership training.\"/><meta property=\"og:url\" content=\"https://cwayacademy.org\"/><meta property=\"og:site_name\" content=\"CWAY Academy\"/><meta property=\"og:locale\" content=\"en_IN\"/><meta property=\"og:image\" content=\"https://cwayacademy.org/og-image.jpg\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"CWAY Academy — Theological Education Platform\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"CWAY Academy — Coach, Challenge, and Commission!\"/><meta name=\"twitter:description\" content=\"Equipping rural pastors and Christian leaders through premium theological education.\"/><meta name=\"twitter:image\" content=\"https://cwayacademy.org/og-image.jpg\"/><link rel=\"shortcut icon\" href=\"/favicon-16x16.png\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.0xpm.hl6sk9qz.ico\" sizes=\"48x48\" type=\"image/x-icon\"/><link rel=\"icon\" href=\"/favicon.ico\"/><link rel=\"apple-touch-icon\" href=\"/apple-touch-icon.png\"/><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"EducationalOrganization\",\"name\":\"CWAY Academy\",\"description\":\"A premier theological training institution equipping rural pastors, lay leaders, and Christian disciples through Bible-based education.\",\"url\":\"https://cwayacademy.org\",\"logo\":\"https://cwayacademy.org/logo.png\",\"contactPoint\":{\"@type\":\"ContactPoint\",\"contactType\":\"admissions\",\"email\":\"admissions@cwayacademy.org\"},\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Bangalore\",\"addressRegion\":\"Karnataka\",\"addressCountry\":\"IN\"},\"foundingOrganization\":{\"@type\":\"Organization\",\"name\":\"CWAY MISSIONS Religious Trust\"}}</script><script src=\"/_next/static/chunks/03~yq9q893hmn.js\" noModule=\"\"></script></head><body><div hidden=\"\"><!--$--><!--/$--></div><section aria-label=\"Notifications alt+T\" tabindex=\"-1\" aria-live=\"polite\" aria-relevant=\"additions text\" aria-atomic=\"false\"></section><div class=\"overflow-hidden\"><section class=\"parchment-bg py-24 px-6\"><div class=\"container\"><div style=\"opacity:0;transform:translateY(20px)\"><div class=\"section-label\">Join the Mission</div><h1 class=\"text-5xl md:text-7xl font-bold font-serif mb-6 leading-tight max-w-4xl\">Partner With Us to <span class=\"gradient-text-gold\">Equip Leaders</span></h1><div class=\"gold-divider gold-divider-left\"></div><p class=\"max-w-2xl text-lg md:text-xl text-[var(--text-secondary)] font-light leading-relaxed mt-6\">We request your partnership to help train Christian leaders for the church in India. Village churches cannot afford training costs without your help.</p></div></div></section><section class=\"py-24 px-6 bg-white\"><div class=\"container\"><div class=\"text-center max-w-3xl mx-auto mb-16\" style=\"opacity:0\"><span class=\"section-label\" style=\"justify-content:center;opacity:0;transform:translateY(24px)\">How You Can Help</span><h2 class=\"text-3xl md:text-5xl font-bold font-serif text-[var(--navy-deep)] mt-3\" style=\"opacity:0;transform:translateY(24px)\">Ways to Get Involved</h2><div class=\"gold-divider\" style=\"opacity:0;transform:translateY(24px)\"></div></div><div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8\" style=\"opacity:0\"><div class=\"bg-white p-8 rounded-[24px] shadow-md border border-[var(--border-light)] hover:shadow-lg transition-all flex flex-col justify-between\" style=\"opacity:0;transform:translateY(24px)\"><div><div style=\"width:56px;height:56px;border-radius:14px;background:var(--navy-light)15;display:flex;align-items:center;justify-content:center;margin-bottom:1.5rem;color:var(--navy-light)\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-heart\" aria-hidden=\"true\"><path d=\"M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5\"></path></svg></div><h4 class=\"text-xl font-bold font-serif text-[var(--navy-deep)] mb-3\">Prayer Partner</h4><p class=\"text-[var(--text-secondary)] text-sm font-light leading-relaxed mb-6\">Become a prayer partner. Get in touch with us to choose a prayer option and receive our regular ministry updates.</p></div><a class=\"btn-primary\" style=\"background:var(--navy-light);display:inline-flex;align-items:center;gap:0.5rem;font-size:0.85rem;padding:0.625rem 1.25rem;border-radius:50px;text-decoration:none;justify-content:center\" href=\"/contact?subject=prayer\">Request Prayer Details<!-- --> <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div><div class=\"bg-white p-8 rounded-[24px] shadow-md border border-[var(--border-light)] hover:shadow-lg transition-all flex flex-col justify-between\" style=\"opacity:0;transform:translateY(24px)\"><div><div style=\"width:56px;height:56px;border-radius:14px;background:var(--gold-primary)15;display:flex;align-items:center;justify-content:center;margin-bottom:1.5rem;color:var(--gold-primary)\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-dollar-sign\" aria-hidden=\"true\"><line x1=\"12\" x2=\"12\" y1=\"2\" y2=\"22\"></line><path d=\"M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6\"></path></svg></div><h4 class=\"text-xl font-bold font-serif text-[var(--navy-deep)] mb-3\">Sponsor a Candidate</h4><p class=\"text-[var(--text-secondary)] text-sm font-light leading-relaxed mb-6\">Contribute a one-time gift of Rs. 15,000/- to fully sponsor one local church candidate for the entire 15-month training program.</p></div><a class=\"btn-primary\" style=\"background:var(--gold-primary);display:inline-flex;align-items:center;gap:0.5rem;font-size:0.85rem;padding:0.625rem 1.25rem;border-radius:50px;text-decoration:none;justify-content:center\" href=\"/get-involved#bank\">Sponsor Today<!-- --> <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div><div class=\"bg-white p-8 rounded-[24px] shadow-md border border-[var(--border-light)] hover:shadow-lg transition-all flex flex-col justify-between\" style=\"opacity:0;transform:translateY(24px)\"><div><div style=\"width:56px;height:56px;border-radius:14px;background:var(--navy-mid)15;display:flex;align-items:center;justify-content:center;margin-bottom:1.5rem;color:var(--navy-mid)\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-calendar\" aria-hidden=\"true\"><path d=\"M8 2v4\"></path><path d=\"M16 2v4\"></path><rect width=\"18\" height=\"18\" x=\"3\" y=\"4\" rx=\"2\"></rect><path d=\"M3 10h18\"></path></svg></div><h4 class=\"text-xl font-bold font-serif text-[var(--navy-deep)] mb-3\">Monthly Supporter</h4><p class=\"text-[var(--text-secondary)] text-sm font-light leading-relaxed mb-6\">Partner with this project by pledging a custom monthly amount to support rural leadership operations across India.</p></div><a class=\"btn-primary\" style=\"background:var(--navy-mid);display:inline-flex;align-items:center;gap:0.5rem;font-size:0.85rem;padding:0.625rem 1.25rem;border-radius:50px;text-decoration:none;justify-content:center\" href=\"/contact?subject=partner\">Setup Partnership<!-- --> <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div><div class=\"bg-white p-8 rounded-[24px] shadow-md border border-[var(--border-light)] hover:shadow-lg transition-all flex flex-col justify-between\" style=\"opacity:0;transform:translateY(24px)\"><div><div style=\"width:56px;height:56px;border-radius:14px;background:var(--gold-light)15;display:flex;align-items:center;justify-content:center;margin-bottom:1.5rem;color:var(--gold-light)\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-message-square\" aria-hidden=\"true\"><path d=\"M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z\"></path></svg></div><h4 class=\"text-xl font-bold font-serif text-[var(--navy-deep)] mb-3\">Share the Vision</h4><p class=\"text-[var(--text-secondary)] text-sm font-light leading-relaxed mb-6\">Share this vision with like-minded people, pastors, and churches in your network who care about training frontline leaders.</p></div><a class=\"btn-primary\" style=\"background:var(--gold-light);display:inline-flex;align-items:center;gap:0.5rem;font-size:0.85rem;padding:0.625rem 1.25rem;border-radius:50px;text-decoration:none;justify-content:center\" href=\"/contact?subject=share\">Contact to Share<!-- --> <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div></div></div></section><section id=\"bank\" class=\"py-24 px-6 bg-[var(--cream-base)]\"><div class=\"container\"><div class=\"grid grid-cols-1 lg:grid-cols-2 gap-16 items-center\"><div class=\"space-y-6\" style=\"opacity:0\"><span class=\"section-label\">Giving Accountability</span><h2 class=\"text-3xl md:text-5xl font-bold font-serif text-[var(--navy-deep)]\">Financial Partnership</h2><p class=\"text-[var(--text-secondary)] text-lg font-light leading-relaxed\">CWAY Academy processes all sponsorships and gifts through CWAY MISSIONS. Sponsor funds go directly to local pastor candidates for course delivery, graduation services, and course materials.</p><div class=\"p-8 bg-white rounded-2xl shadow-sm border border-[var(--border-light)] flex gap-4 items-start\"><span class=\"text-[var(--gold-primary)] text-2xl\">✓</span><div><h4 class=\"text-lg font-bold text-[var(--navy-deep)] mb-1\">Direct Scholarship</h4><p class=\"text-sm text-[var(--text-secondary)] font-light\">100% of candidate sponsorships fund student study tools, internet allocations, and printed materials.</p></div></div><div class=\"p-8 bg-white rounded-2xl shadow-sm border border-[var(--border-light)] flex gap-4 items-start\"><span class=\"text-[var(--gold-primary)] text-2xl\">✓</span><div><h4 class=\"text-lg font-bold text-[var(--navy-deep)] mb-1\">Regular Reporting</h4><p class=\"text-sm text-[var(--text-secondary)] font-light\">Receive regular updates on your sponsored candidate&#x27;s progress and invitations to local graduation services.</p></div></div></div><div class=\"flex justify-center\" style=\"opacity:0;transform:scale(0.95)\"><div class=\"w-full bg-white border border-[var(--border-light)] p-10 md:p-14 rounded-[32px] shadow-lg border-t-8 border-t-[var(--gold-primary)]\"><div class=\"w-16 h-16 rounded-full bg-[var(--gold-pale)]/50 text-[var(--gold-dark)] flex items-center justify-center text-2xl mx-auto mb-8 font-bold\">🏦</div><h3 class=\"text-3xl font-bold font-serif mb-8 text-[var(--navy-deep)] text-center\">Bank Details</h3><div class=\"space-y-5 text-left max-w-md mx-auto text-base md:text-lg\"><p class=\"flex justify-between border-b border-[var(--cream-mid)] pb-3 text-[var(--text-secondary)] font-light\"><span class=\"font-semibold text-[var(--navy-deep)]\">Account Name:</span><span>CWAY MISSIONS</span></p><p class=\"flex justify-between border-b border-[var(--cream-mid)] pb-3 text-[var(--text-secondary)] font-light\"><span class=\"font-semibold text-[var(--navy-deep)]\">Bank:</span><span class=\"text-right\">Federal Bank <br/><span class=\"text-xs text-[var(--text-muted)]\">Banaswadi Branch</span></span></p><p class=\"flex justify-between border-b border-[var(--cream-mid)] pb-3 text-[var(--text-secondary)] font-light\"><span class=\"font-semibold text-[var(--navy-deep)]\">Account No:</span><span class=\"font-mono text-[var(--gold-dark)] font-semibold\">14710200017349</span></p><p class=\"flex justify-between pb-3 text-[var(--text-secondary)] font-light\"><span class=\"font-semibold text-[var(--navy-deep)]\">IFSC:</span><span class=\"font-mono text-[var(--gold-dark)] font-semibold\">FDRL0001471</span></p></div></div></div></div></div></section><section class=\"bg-[var(--navy-deep)] py-24 px-6 text-white text-center\"><div class=\