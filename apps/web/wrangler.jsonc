{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cwayacademylms",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "minify": true,
  "usage_model": "unbound",
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://www.cwayacademy.com",
    "NEXT_PUBLIC_API_URL": "https://api.cwayacademy.com/"
  }
}
